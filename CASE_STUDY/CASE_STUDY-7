<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JavaScript Event Handling & Form Validation</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            min-height: 100vh;
            padding: 20px;
        }
        
        .container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            padding: 40px;
        }
        
        h1 {
            text-align: center;
            color: #f5576c;
            margin-bottom: 10px;
            font-size: 2.2em;
        }
        
        .subtitle {
            text-align: center;
            color: #666;
            margin-bottom: 30px;
            font-size: 1.1em;
        }
        
        .form-group {
            margin-bottom: 25px;
        }
        
        label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: 600;
            font-size: 14px;
        }
        
        label .required {
            color: #f5576c;
        }
        
        input[type="text"],
        input[type="email"],
        input[type="password"],
        input[type="tel"],
        input[type="number"],
        select,
        textarea {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 15px;
            transition: all 0.3s;
        }
        
        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="password"]:focus,
        input[type="tel"]:focus,
        input[type="number"]:focus,
        select:focus,
        textarea:focus {
            outline: none;
            border-color: #f5576c;
            box-shadow: 0 0 0 3px rgba(245, 87, 108, 0.1);
        }
        
        input.error {
            border-color: #f5576c;
            background-color: #fff5f5;
        }
        
        input.success {
            border-color: #10b981;
            background-color: #f0fdf4;
        }
        
        .error-message {
            color: #f5576c;
            font-size: 13px;
            margin-top: 5px;
            display: none;
        }
        
        .error-message.show {
            display: block;
        }
        
        .hint {
            color: #666;
            font-size: 12px;
            margin-top: 5px;
            font-style: italic;
        }
        
        .password-requirements {
            font-size: 12px;
            margin-top: 8px;
            padding: 10px;
            background: #f8f9fa;
            border-radius: 5px;
        }
        
        .requirement {
            margin: 3px 0;
            color: #666;
        }
        
        .requirement.met {
            color: #10b981;
        }
        
        .requirement.not-met {
            color: #f5576c;
        }
        
        .button-group {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }
        
        button {
            flex: 1;
            padding: 14px 28px;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .submit-btn {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
        }
        
        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(245, 87, 108, 0.4);
        }
        
        .reset-btn {
            background: #6b7280;
            color: white;
        }
        
        .reset-btn:hover {
            background: #4b5563;
        }
        
        .event-log {
            margin-top: 30px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 10px;
            border-left: 5px solid #f5576c;
        }
        
        .event-log h3 {
            color: #f5576c;
            margin-bottom: 15px;
        }
        
        .log-entry {
            padding: 8px 12px;
            background: white;
            margin-bottom: 8px;
            border-radius: 5px;
            font-size: 14px;
            border-left: 3px solid #f093fb;
            animation: slideIn 0.3s;
        }
        
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        
        .success-message {
            background: #10b981;
            color: white;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            margin-top: 20px;
            display: none;
        }
        
        .success-message.show {
            display: block;
            animation: fadeIn 0.5s;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        .char-count {
            text-align: right;
            font-size: 12px;
            color: #666;
            margin-top: 5px;
        }
        
        .char-count.warning {
            color: #f59e0b;
        }
        
        .char-count.danger {
            color: #f5576c;
        }
        
        fieldset {
            border: 2px solid #ddd;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }
        
        legend {
            color: #f5576c;
            font-weight: 600;
            padding: 0 10px;
        }
        
        .inline-fields {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }
        
        @media (max-width: 600px) {
            .inline-fields {
                grid-template-columns: 1fr;
            }
            .button-group {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>📝 Registration Form</h1>
        <p class="subtitle">Event Handling & Form Validation Demo</p>
        
        <form id="registrationForm" novalidate>
            <fieldset>
                <legend>Personal Information</legend>
                <div class="inline-fields">
                    <div class="form-group">
                        <label for="firstName">First Name <span class="required">*</span></label>
                        <input type="text" id="firstName" name="firstName" placeholder="Enter first name">
                        <div class="error-message" id="firstNameError">Please enter your first name</div>
                    </div>
                    
                    <div class="form-group">
                        <label for="lastName">Last Name <span class="required">*</span></label>
                        <input type="text" id="lastName" name="lastName" placeholder="Enter last name">
                        <div class="error-message" id="lastNameError">Please enter your last name</div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="email">Email Address <span class="required">*</span></label>
                    <input type="email" id="email" name="email" placeholder="example@email.com">
                    <div class="error-message" id="emailError">Please enter a valid email address</div>
                    <div class="hint">We'll never share your email with anyone</div>
                </div>
                
                <div class="form-group">
                    <label for="phone">Phone Number <span class="required">*</span></label>
                    <input type="tel" id="phone" name="phone" placeholder="+1 (555) 123-4567">
                    <div class="error-message" id="phoneError">Please enter a valid 10-digit phone number</div>
                </div>
            </fieldset>
            
            <fieldset>
                <legend>Account Details</legend>
                
                <div class="form-group">
                    <label for="password">Password <span class="required">*</span></label>
                    <input type="password" id="password" name="password" placeholder="Create a password">
                    <div class="error-message" id="passwordError">Password must be at least 8 characters with uppercase, lowercase, and number</div>
                    <div class="password-requirements" id="passwordRequirements">
                        <div class="requirement" id="req-length">⚫ At least 8 characters</div>
                        <div class="requirement" id="req-lowercase">⚫ Contains lowercase letter</div>
                        <div class="requirement" id="req-uppercase">⚫ Contains uppercase letter</div>
                        <div class="requirement" id="req-number">⚫ Contains number</div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="confirmPassword">Confirm Password <span class="required">*</span></label>
                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter password">
                    <div class="error-message" id="confirmPasswordError">Passwords do not match</div>
                </div>
                
                <div class="form-group">
                    <label for="country">Country <span class="required">*</span></label>
                    <select id="country" name="country">
                        <option value="">Select your country</option>
                        <option value="usa">United States</option>
                        <option value="uk">United Kingdom</option>
                        <option value="canada">Canada</option>
                        <option value="australia">Australia</option>
                        <option value="india">India</option>
                        <option value="other">Other</option>
                    </select>
                    <div class="error-message" id="countryError">Please select a country</div>
                </div>
            </fieldset>
            
            <fieldset>
                <legend>Additional Information</legend>
                
                <div class="form-group">
                    <label for="bio">Brief Bio</label>
                    <textarea id="bio" name="bio" rows="4" placeholder="Tell us about yourself (max 200 characters)"></textarea>
                    <div class="char-count" id="charCount">0/200 characters</div>
                </div>
                
                <div class="form-group">
                    <label for="age">Age</label>
                    <input type="number" id="age" name="age" placeholder="Your age" min="1" max="120">
                    <div class="error-message" id="ageError">Please enter a valid age between 1 and 120</div>
                </div>
            </fieldset>
            
            <div class="button-group">
                <button type="submit" class="submit-btn">Submit Registration</button>
                <button type="reset" class="reset-btn">Reset Form</button>
            </div>
        </form>
        
        <div class="success-message" id="successMessage">
            <h2>✅ Registration Successful!</h2>
            <p>Thank you for registering. We've received your information.</p>
        </div>
        
        <div class="event-log">
            <h3>📊 Event Log</h3>
            <div id="logContainer">
                <div class="log-entry">Form loaded. Start filling the form...</div>
            </div>
        </div>
    </div>
    
    <script>
        // Get form elements
        const form = document.getElementById('registrationForm');
        const logContainer = document.getElementById('logContainer');
        const successMessage = document.getElementById('successMessage');
        
        // Event logging function
        function logEvent(eventName, fieldName = '') {
            const timestamp = new Date().toLocaleTimeString();
            const entry = document.createElement('div');
            entry.className = 'log-entry';
            entry.textContent = `[${timestamp}] ${eventName}${fieldName ? ' - ' + fieldName : ''}`;
            logContainer.insertBefore(entry, logContainer.firstChild);
            
            // Keep only last 10 entries
            while (logContainer.children.length > 10) {
                logContainer.removeChild(logContainer.lastChild);
            }
        }
        
        // Validation functions
        function validateEmail(email) {
            const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return re.test(email);
        }
        
        function validatePhone(phone) {
            const digits = phone.replace(/\D/g, '');
            return digits.length >= 10;
        }
        
        // IMPROVED: Password validation with detailed checks
        function validatePassword(password) {
            const checks = {
                hasMinLength: password.length >= 8,
                hasLowercase: /[a-z]/.test(password),
                hasUppercase: /[A-Z]/.test(password),
                hasNumber: /\d/.test(password)
            };
            
            // Update requirement indicators
            updateRequirement('req-length', checks.hasMinLength);
            updateRequirement('req-lowercase', checks.hasLowercase);
            updateRequirement('req-uppercase', checks.hasUppercase);
            updateRequirement('req-number', checks.hasNumber);
            
            // Password is valid only if all checks pass
            return checks.hasMinLength && checks.hasLowercase && checks.hasUppercase && checks.hasNumber;
        }
        
        function updateRequirement(reqId, isMet) {
            const req = document.getElementById(reqId);
            if (req) {
                if (isMet) {
                    req.classList.add('met');
                    req.classList.remove('not-met');
                    req.textContent = '✅ ' + req.textContent.substring(2);
                } else {
                    req.classList.remove('met');
                    req.classList.add('not-met');
                    req.textContent = '⚫ ' + req.textContent.substring(2);
                }
            }
        }
        
        function showError(fieldId, show = true) {
            const field = document.getElementById(fieldId);
            const errorDiv = document.getElementById(fieldId + 'Error');
            if (show) {
                field.classList.add('error');
                field.classList.remove('success');
                if (errorDiv) errorDiv.classList.add('show');
            } else {
                field.classList.remove('error');
                field.classList.add('success');
                if (errorDiv) errorDiv.classList.remove('show');
            }
        }
        
        // Focus event
        const inputs = form.querySelectorAll('input, select, textarea');
        inputs.forEach(input => {
            input.addEventListener('focus', function() {
                logEvent('Focus', this.name || this.id);
                this.classList.remove('error');
            });
            
            // Blur event
            input.addEventListener('blur', function() {
                logEvent('Blur', this.name || this.id);
                validateField(this.id);
            });
            
            // Change event
            input.addEventListener('change', function() {
                logEvent('Change', this.name || this.id);
            });
            
            // Input event (for real-time validation)
            input.addEventListener('input', function() {
                if (this.id === 'password') {
                    // Real-time password validation
                    validatePassword(this.value);
                    if (this.value.length > 0) {
                        const isValid = validatePassword(this.value);
                        showError('password', !isValid);
                    } else {
                        showError('password', false);
                    }
                } else if (this.classList.contains('error')) {
                    validateField(this.id);
                }
            });
        });
        
        // Character count for bio
        const bioField = document.getElementById('bio');
        const charCount = document.getElementById('charCount');
        
        bioField.addEventListener('input', function() {
            const length = this.value.length;
            charCount.textContent = `${length}/200 characters`;
            charCount.classList.remove('warning', 'danger');
            
            if (length > 180) {
                charCount.classList.add('danger');
            } else if (length > 150) {
                charCount.classList.add('warning');
            }
            
            if (length > 200) {
                this.value = this.value.substring(0, 200);
                charCount.textContent = '200/200 characters (max reached)';
            }
        });
        
        // Individual field validation
        function validateField(fieldId) {
            const field = document.getElementById(fieldId);
            const value = field.value.trim();
            let isValid = true;
            
            switch(fieldId) {
                case 'firstName':
                case 'lastName':
                    isValid = value.length > 0;
                    break;
                case 'email':
                    isValid = validateEmail(value);
                    break;
                case 'phone':
                    isValid = validatePhone(value);
                    break;
                case 'password':
                    isValid = validatePassword(value);
                    break;
                case 'confirmPassword':
                    const password = document.getElementById('password').value.trim();
                    isValid = value === password && value.length > 0;
                    break;
                case 'country':
                    isValid = value !== '';
                    break;
                case 'age':
                    const age = parseInt(value);
                    isValid = value === '' || (age >= 1 && age <= 120);
                    break;
            }
            
            showError(fieldId, !isValid);
            return isValid;
        }
        
        // Form submission
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            logEvent('Submit');
            
            // Validate all fields
            const fields = ['firstName', 'lastName', 'email', 'phone', 'password', 'confirmPassword', 'country'];
            let isFormValid = true;
            
            fields.forEach(fieldId => {
                if (!validateField(fieldId)) {
                    isFormValid = false;
                }
            });
            
            // Validate age if filled
            const ageField = document.getElementById('age');
            if (ageField.value !== '' && !validateField('age')) {
                isFormValid = false;
            }
            
            if (isFormValid) {
                // Show success message
                successMessage.classList.add('show');
                logEvent('Success', 'Form submitted successfully');
                
                // Scroll to success message
                successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
                
                // Hide success message after 5 seconds
                setTimeout(() => {
                    successMessage.classList.remove('show');
                }, 5000);
                
                // In a real application, you would submit the form data here
                console.log('Form data:', new FormData(form));
            } else {
                logEvent('Error', 'Form validation failed');
                alert('Please fix the errors in the form before submitting.');
            }
        });
        
        // Form reset
        form.addEventListener('reset', function() {
            logEvent('Reset');
            successMessage.classList.remove('show');
            
            // Clear all error states
            inputs.forEach(input => {
                input.classList.remove('error', 'success');
            });
            
            // Hide all error messages
            const errorMessages = document.querySelectorAll('.error-message');
            errorMessages.forEach(msg => msg.classList.remove('show'));
            
            // Reset password requirements
            ['req-length', 'req-lowercase', 'req-uppercase', 'req-number'].forEach(reqId => {
                const req = document.getElementById(reqId);
                if (req) {
                    req.classList.remove('met', 'not-met');
                }
            });
            
            // Reset char count
            charCount.textContent = '0/200 characters';
            charCount.classList.remove('warning', 'danger');
            
            setTimeout(() => {
                alert('Form has been reset');
            }, 100);
        });
        
        // Add enter key logging
        document.addEventListener('keypress', function(e) {
            if (e.key === 'Enter' && e.target.tagName === 'INPUT') {
                logEvent('Enter Key', e.target.name || e.target.id);
            }
        });
    </script>
</body>
</html>
